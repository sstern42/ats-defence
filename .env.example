# Copy to .env.local to set these for a build. Nothing here is a secret, and
# nothing that is one ever goes in a VITE_ variable: Vite inlines them into the
# client bundle, where anybody can read them.

# Where analytics events are posted. Left empty, nothing is sent and events are
# kept on window.requisita.events for looking at in the console. Add ?analytics
# to the URL to have them printed there as well.
VITE_ANALYTICS_ENDPOINT=
