# Copy to .env.local to set these for a build. Nothing here is a secret, and
# nothing that is one ever goes in a VITE_ variable: Vite inlines them into the
# client bundle, where anybody can read them.

# Override for where analytics events are posted. Left empty, they go to this
# site's own collector function at /.netlify/functions/collect, which is what
# you want. Set it only to send them somewhere else instead.
#
# Events are always kept on window.requisita.events as well, and ?analytics in
# the URL prints them to the console.
VITE_ANALYTICS_ENDPOINT=

# GrowthBook client key, for the starting difficulty experiment. Public by
# design: it reads feature definitions and nothing else, which is why it is the
# one key here allowed a VITE_ prefix. Left empty, every run plays the control
# arm and reports itself as unassigned rather than as control.
VITE_GROWTHBOOK_CLIENT_KEY=

# Only needed for a self-hosted GrowthBook. Defaults to https://cdn.growthbook.io
VITE_GROWTHBOOK_API_HOST=

# --------------------------------------------------------------------------
# Server side only. These are read by the Netlify functions and are set in the
# Netlify dashboard, not here and not in the repo. They are listed so it is
# obvious what a working deploy needs.
#
# Note the absence of a VITE_ prefix on all three. The browser never talks to
# Supabase, so it needs no key at all.
# --------------------------------------------------------------------------

# The Supabase project URL, e.g. https://abcdefgh.supabase.co
# SUPABASE_URL=

# The service role key, called the secret key in newer dashboards. It bypasses
# row level security, so it lives in the Netlify environment and nowhere else.
# SUPABASE_SERVICE_ROLE_KEY=

# Salt for hashing addresses before they are stored for rate limiting. Any long
# random string. Falls back to the service role key if unset, which works but is
# worth setting properly.
# IP_HASH_SALT=
